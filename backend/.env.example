# ============================================================
# HYTICON — Variables de Entorno Backend (Producción)
# ============================================================

# ── Servidor ────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Base de Datos PostgreSQL ─────────────────────────────────
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:password_seguro@db.hyticon.com:5432/hyticon_db?schema=public

# ── Autenticación JWT & Secrets ──────────────────────────────
# Generar claves criptográficas seguras (ej: openssl rand -base64 64)
JWT_SECRET=reemplazar_con_un_secreto_aleatorio_muy_largo_y_seguro
JWT_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=reemplazar_con_otro_secreto_aleatorio_distinto_y_seguro
REFRESH_TOKEN_EXPIRES_IN=7d

# ── CORS / Dominio del Frontend ──────────────────────────────
# URL pública del frontend autorizada para cookies e intercambio de credenciales
FRONTEND_URL=https://app.hyticon.com

# ── Reglas de Negocio ────────────────────────────────────────
IGV_PORCENTAJE=0.18

# ── n8n (Automatización Webhooks) ────────────────────────────
N8N_WEBHOOK_URL=https://n8n.hyticon.com/webhook/cotizaciones
N8N_WEBHOOK_SECRET=clave_secreta_hmac_sha256_compartida_con_n8n

# ── Supabase Storage (Opcional) ──────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_BUCKET=cotizaciones-pdf
